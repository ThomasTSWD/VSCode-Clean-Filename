{
  "name": "clean-filename",
  "displayName": "VSCode Clean Filename",
  "description": "Clean file names from the Explorer: remove accents, spaces and special characters.",
  "version": "1.3.1",
  "author": "thomas-serment",
  "publisher": "thomas-serment",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomas-serment/VSCode-Clean-Filename"
  },
  "bugs": {
    "url": "https://github.com/thomas-serment/VSCode-Clean-Filename/issues"
  },
  "homepage": "https://github.com/thomas-serment/VSCode-Clean-Filename#readme",
  "icon": "images/icon.png",
  "keywords": [
    "filename",
    "rename",
    "clean",
    "slug",
    "accents"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clean-filename.clean",
        "title": "Clean File Names",
        "category": "Clean Filename"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "clean-filename.clean",
          "when": "resourceScheme == file",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "clean-filename.clean",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
